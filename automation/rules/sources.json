  "generic": {
    "fields": {
      "amount": [
        "(?i)(?:nominal|jumlah|total\\s*(?:pembayaran|transaksi|tagihan|belanja)?|amount|sebesar|nilai\\s*transaksi|grand\\s*total)\\s*[:\\-]?\\s*(?:rp\\.?|idr)?\\s*([0-9][0-9.,]*)",
        "(?i)\\b(?:rp\\.?|idr)\\s*([0-9][0-9.,]*)"
      ],
      "date": [
        "(?i)(?:tanggal|tgl|waktu|date|time)\\s*(?:transaksi|pembayaran)?\\s*[:\\-]?\\s*([0-9]{1,2}[/\\-.][0-9]{1,2}[/\\-.][0-9]{2,4}(?:[ ,]+[0-9]{1,2}[:.][0-9]{2}(?:[:.][0-9]{2})?)?)",
        "(?i)(?:tanggal|tgl|waktu|date)\\s*[:\\-]?\\s*([0-9]{1,2}\\s+[A-Za-z]{3,9}\\.?\\s+[0-9]{4}(?:[ ,]+[0-9]{1,2}[:.][0-9]{2}(?:[:.][0-9]{2})?)?)",
        "(?i)\\b([0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}(?::[0-9]{2})?)"
      ],
      "merchant": [
        "(?i)(?:merchant|penerima|tujuan|kepada|toko|nama\\s*toko|biller|ke\\s*rekening)\\s*[:\\-]\\s*([^\\n\\r]{2,60})",
        "(?i)(?:pembayaran|pembelian|transaksi)\\s+(?:di|ke|pada)\\s+([^\\n\\r]{2,60})"
      ],
      "account": [
        "(?i)(?:rekening|no\\.?\\s*rek(?:ening)?|kartu|card|sumber\\s*dana|debit\\s*dari|account)\\s*(?:sumber|asal|anda)?\\s*[:\\-]?\\s*([0-9xX*]{4,20})",
        "(?i)\\b([0-9xX*]{2,}[*xX]{2,}[0-9]{4})\\b"
      ],
      "reference": [
        "(?i)(?:no\\.?\\s*(?:ref(?:erensi)?|transaksi)|reference|trx\\s*id|transaction\\s*id|invoice)\\s*[:\\-]?\\s*([A-Za-z0-9\\-/]{4,40})"
      ]
    },
    "direction_rules": [
      {
        "priority": 90,
        "direction": "credit",
        "any": [
          "dana masuk",
          "uang masuk",
          "diterima",
          "penerimaan",
          "kredit sebesar",
          "top up berhasil dari",
          "refund",
          "pengembalian dana",
          "cashback",
          "gaji",
          "payroll",
          "bagi hasil",
          "bunga",
          "dividen",
          "incoming transfer",
          "credited"
        ]
      },
      {
        "priority": 80,
        "direction": "debit",
        "any": [
          "pembayaran",
          "pembelian",
          "transaksi berhasil",
          "dana keluar",
          "uang keluar",
          "debet",
          "didebet",
          "penarikan",
          "transfer ke",
          "tagihan",
          "biaya",
          "berhasil dibayar",
          "purchase",
          "debited",
          "withdrawal"
        ]
      }
    ],
    "transfer_hints": [
      "transfer ke",
      "transfer antar",
      "pindah dana",
      "top up",
      "topup",
      "isi saldo",
      "overbooking",
      "ke rekening sendiri"
    ]
  }
}
