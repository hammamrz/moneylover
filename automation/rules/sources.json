        "subject": []
      },
      "channel_default": "card",
      "fields": {
        "amount": [
          "Nominal Transaksi\\s*:\\s*Rp\\s*([\\d.,]+)"
        ],
        "date": [
          "Tanggal Transaksi\\s*:\\s*([\\d/]{8,10}(?:\\s+[\\d:]{5})?)"
        ],
        "merchant": [
          "Nama Merchant\\s*:\\s*([^\\n]+)"
        ]
      },
      "direction_rules": [
        {
          "priority": 99,
          "direction": "debit",
          "any": [
            "notifikasi transaksi",
            "terima kasih atas transaksi"
          ]
        }
      ],
      "ignore_subject": [
        "e-billing"
      ]
    },
