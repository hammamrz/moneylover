{
  "version": 2,
  "_comment": "Pola pengenal email per penerbit. 'match.from' dicocokkan ke alamat pengirim, 'match.subject' ke subjek. 'fields' adalah daftar regex yang dicoba berurutan; grup 1 diambil sebagai nilai. Bila satu sumber baru belum ada di sini, pipeline tetap memakai blok 'generic' dan menandai transaksi sebagai needs_review.",
  "sources": [
    {
      "id": "bni_wondr",
      "label": "BNI",
      "kind": "bank",
      "match": {
        "from": [
          "wondr@bni.co.id"
        ],
        "subject": [
          "wondr"
        ]
      },
      "channel_default": "transfer",
      "fields": {
        "amount": [
          "\\|\\s*Nominal\\s*\\|\\s*Rp\\s*([\\d.,]+)",
          "\\|\\s*Total\\s*\\|\\s*Rp\\s*([\\d.,]+)"
        ],
        "date": [
          "\\|\\s*Tanggal\\s*\\|\\s*([^|\\n]+)"
        ],
        "time": [
          "\\|\\s*Waktu\\s*\\|\\s*([\\d:]{5,8})"
        ],
        "merchant": [
          "\\|\\s*Penerima\\s*\\|\\s*\\n\\|\\s*([^|\\n]+?)\\s*\\|",
          "\\|\\s*Tujuan\\s*\\|\\s*\\n\\|\\s*([^|\\n]+?)\\s*\\|"
        ],
        "account": [
          "\\|\\s*(TAPLUS[^|\\n]*?)\\s*\\|"
        ],
        "reference": [
          "\\|\\s*Reference ID\\s*\\|\\s*([A-Za-z0-9]+)"
        ],
        "merchant_credit": [
          "\\|\\s*Pengirim[#:]*\\s*\\|?\\s*([^|\\n]+)"
        ]
      },
      "direction_rules": [
        {
          "priority": 99,
          "direction": "credit",
          "any": [
            "dana masuk",
            "uang masuk",
            "kamu baru aja terima"
          ]
        },
        {
          "priority": 98,
          "direction": "debit",
          "any": [
            "baru aja bayar",
            "baru aja transfer",
            "pembayaran pakai",
            "transfer berhasil"
          ]
        }
      ]
    },
    {
      "id": "bni_cc",
      "label": "BNI Kartu Kredit",
      "kind": "card",
      "match": {
        "from": [
          "bnicreditcard@bni.co.id",
          "billing@bni.co.id"
